<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.network_monitor.portal_service.mapper.DeviceCredentialMapper">

    <resultMap id="DeviceCredentialEntityMap"
            type="com.network_monitor.portal_service.model.entity.DeviceCredential">

        <id property="id" column="id"/>

        <result property="credentialName" column="credential_name"/>
        <result property="credentialType" column="credential_type"/>
        <result property="protocolType" column="protocol_type"/>
        <result property="port" column="port"/>
        <result property="communityString" column="community_string"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

        <association property="device"
                    javaType="com.network_monitor.portal_service.model.entity.Device">
            <id property="id" column="device_id"/>
        </association>

    </resultMap>

    <sql id="CredentialWhereClause">
        <where>
            dc.device_id = #{deviceId}

            <if test="keyword != null and keyword.trim() != ''">
                AND (
                    dc.credential_name ILIKE CONCAT('%', #{keyword}, '%')
                    OR dc.credential_type ILIKE CONCAT('%', #{keyword}, '%')
                    OR dc.protocol_type ILIKE CONCAT('%', #{keyword}, '%')
                    OR COALESCE(dc.community_string, '')
                        ILIKE CONCAT('%', #{keyword}, '%')
                    OR COALESCE(CAST(dc.port AS TEXT), '')
                        ILIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
    </sql>

    <select id="searchCredentialsByDeviceId"
            resultMap="DeviceCredentialEntityMap">
        SELECT
            dc.id,
            dc.device_id,
            dc.credential_name,
            dc.credential_type,
            dc.protocol_type,
            dc.port,
            dc.community_string,
            dc.is_active,
            dc.created_at,
            dc.updated_at
        FROM device_credentials dc

        <include refid="CredentialWhereClause"/>

        ORDER BY
        <choose>
            <when test="sortBy == 'id'">dc.id</when>
            <when test="sortBy == 'deviceId'">dc.device_id</when>
            <when test="sortBy == 'credentialName'">dc.credential_name</when>
            <when test="sortBy == 'credentialType'">dc.credential_type</when>
            <when test="sortBy == 'protocolType'">dc.protocol_type</when>
            <when test="sortBy == 'port'">dc.port</when>
            <when test="sortBy == 'communityString'">dc.community_string</when>
            <when test="sortBy == 'isActive'">dc.is_active</when>
            <when test="sortBy == 'createdAt'">dc.created_at</when>
            <when test="sortBy == 'updatedAt'">dc.updated_at</when>
            <otherwise>dc.created_at</otherwise>
        </choose>

        <choose>
            <when test="direction != null and direction.toUpperCase() == 'ASC'">
                ASC
            </when>
            <otherwise>DESC</otherwise>
        </choose>

        LIMIT #{limit}
        OFFSET #{offset}
    </select>

    <select id="countCredentialsByDeviceId" resultType="long">
        SELECT COUNT(*)
        FROM device_credentials dc
        <include refid="CredentialWhereClause"/>
    </select>

</mapper>
