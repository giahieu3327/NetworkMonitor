# ==========================================
# APP SERVER CONFIG
# ==========================================
PORTAL_SERVER_PORT=5000


# ==========================================
# POSTGRESQL CONFIG
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Databases
POSTGRES_DB_MONITOR=monitor_db
POSTGRES_DB_CAMUNDA=camunda_db


# ==========================================
# KEYCLOAK CONFIG
# ==========================================
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=monitor-realm
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_password
KEYCLOAK_CLIENT_ID=monitor-frontend


# ==========================================
# REDIS CONFIG
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_password


# ==========================================
# KAFKA CONFIG
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# ==========================================
# MAIL CONFIG (STALWART)
# ==========================================
STALWART_HOST=localhost
STALWART_SUBMISSION_PORT=587
STALWART_MAIL_USER=admin@monitor.com
STALWART_MAIL_PASSWORD=your_password


# ==========================================
# CAMUNDA CONFIG
# ==========================================
CAMUNDA_ADMIN_ID=camunda-admin
CAMUNDA_ADMIN_PASSWORD=your_password


# ==========================================
# APP ADMIN CONFIG
# ==========================================
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@monitor.com
APP_ADMIN_PASSWORD=your_password