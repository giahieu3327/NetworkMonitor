# ==========================================
# APP SERVER CONFIG
# ==========================================
PORTAL_SERVER_PORT=5000
MONITOR_SERVER_PORT=5001

# ==========================================
# MONITOR SERVICE SPECIFIC CONFIG
# ==========================================
SQLITE_DB_PATH=monitor_local.db
SNMP_TIMEOUT=1500
SNMP_RETRIES=2
SYSLOG_PORT=5140
SYSLOG_PROTOCOL=udp

# ==========================================
# POSTGRESQL CONFIG
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Databases
POSTGRES_DB_MONITOR=monitor_db
POSTGRES_DB_CAMUNDA=camunda_db
POSTGRES_DB_KEYCLOAK=keycloak_db

# ==========================================
# KEYCLOAK CONFIG
# ==========================================
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=monitor-realm
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_password
KEYCLOAK_CLIENT_ID=monitor-frontend

# ==========================================
# REDIS CONFIG
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_password

# ==========================================
# KAFKA CONFIG
# ==========================================
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==========================================
# MAILPIT CONFIG
# ==========================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_WEB_PORT=8025

# ==========================================
# CAMUNDA CONFIG
# ==========================================
CAMUNDA_ADMIN_ID=camunda-admin
CAMUNDA_ADMIN_PASSWORD=your_password

# ==========================================
# UI MANAGEMENT TOOLS PORTS
# ==========================================
PGADMIN_PORT=8081
PGADMIN_DEFAULT_EMAIL=admin@monitor.com
PGADMIN_DEFAULT_PASSWORD=your_password

REDIS_INSIGHT_PORT=5540
KAFKA_UI_PORT=8082

# ==========================================
# APP ADMIN CONFIG
# ==========================================
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@monitor.com
APP_ADMIN_PASSWORD=your_password